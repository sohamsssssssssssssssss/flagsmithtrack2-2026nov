{
  "name": "@blast/agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "lint": "tsc -p . --noEmit",
    "dev": "tsx watch src/index.ts",
    "toggle": "tsx src/toggle.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@blast/shared": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
